{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "social-manifest.schema.json",
  "title": "SocialManifest",
  "description": "Bir sosyal medya import'unun özeti. Ajan önce bunu okuyup neyin mevcut olduğunu görür.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "platforms"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "schemas/ altındaki şema dosyasına göreli yol"
    },
    "schema_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "platform",
          "files",
          "item_count"
        ],
        "additionalProperties": false,
        "properties": {
          "platform": {
            "enum": [
              "instagram",
              "twitter",
              "tiktok",
              "pinterest",
              "whatsapp",
              "claude",
              "youtube"
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "item_count": {
            "type": "integer",
            "minimum": 0
          },
          "counts_by_type": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "date_range": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            }
          },
          "counts_by_period": {
            "type": "object",
            "description": "6 aylik donemlere gore kayit sayilari, orn {2024H1: 120, 2024H2: 340}",
            "additionalProperties": {
              "type": "integer"
            }
          }
        }
      }
    },
    "note": {
      "type": "string"
    }
  }
}
