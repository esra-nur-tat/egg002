{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scale.schema.json",
  "title": "Scale",
  "description": "Haftalık/aylık psikolojik ölçek tanımı (WHO-5, öz-şefkat vb.).",
  "type": "object",
  "required": [
    "id",
    "name",
    "items",
    "response_options",
    "scoring"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "schemas/ altındaki şema dosyasına göreli yol"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "name": {
      "type": "string"
    },
    "name_tr": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "period": {
      "enum": [
        "weekly",
        "monthly"
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "n",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "n": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "reverse": {
            "type": "boolean"
          }
        }
      }
    },
    "response_options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "value",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "integer"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "scoring": {
      "type": "object",
      "required": [
        "method"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "sum",
            "mean"
          ]
        },
        "multiplier": {
          "type": "number",
          "description": "örn. WHO-5'te x4 ile 0-100"
        },
        "range": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        "interpretation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "min",
              "max",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "label": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  }
}
