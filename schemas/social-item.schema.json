{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "social-item.schema.json",
  "title": "SocialItem",
  "description": "Sosyal medya export'undan normalize edilmiş tek kayıt. items.jsonl'de her satır bir SocialItem.",
  "type": "object",
  "required": [
    "platform",
    "type",
    "id",
    "timestamp"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "schemas/ altındaki şema dosyasına göreli yol"
    },
    "platform": {
      "enum": [
        "instagram",
        "twitter",
        "tiktok",
        "pinterest",
        "whatsapp",
        "claude",
        "youtube"
      ]
    },
    "type": {
      "enum": [
        "post",
        "like",
        "comment",
        "message",
        "follow",
        "search",
        "view",
        "share",
        "save",
        "other"
      ]
    },
    "id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 veya platformun verdiği tarih formatı"
    },
    "text": {
      "type": "string"
    },
    "media_url": {
      "type": "string"
    },
    "link_url": {
      "type": "string"
    },
    "target_id": {
      "type": "string",
      "description": "Etkileşilen içerik/kişi id'si (like, follow, comment için)"
    },
    "extra": {
      "type": "object",
      "description": "Platforma özel alanlar; normalize edilemeyen detaylar burada"
    }
  }
}
