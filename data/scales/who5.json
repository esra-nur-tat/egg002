{
  "$schema": "../../schemas/scale.schema.json",
  "id": "who5",
  "name": "WHO-5 Well-Being Index",
  "name_tr": "WHO-5 İyi Oluş İndeksi",
  "description": "5 maddelik, ücretsiz kullanılabilen iyi-oluş ölçeği. Son 2 hafta değerlendirilir.",
  "period": "weekly",
  "items": [
    { "n": 1, "text": "Kendimi neşeli ve iyi bir ruh halinde hissettim." },
    { "n": 2, "text": "Kendimi sakin ve rahat hissettim." },
    { "n": 3, "text": "Kendimi enerjik ve dinç hissettim." },
    { "n": 4, "text": "Taze ve dinlenmiş olarak uyandım." },
    { "n": 5, "text": "Günlük yaşamım beni ilgilendiren şeylerle doluydu." }
  ],
  "response_options": [
    { "value": 0, "label": "Hiçbir zaman" },
    { "value": 1, "label": "Bazen" },
    { "value": 2, "label": "Zamanın yarısından azında" },
    { "value": 3, "label": "Zamanın yarısından çoğunda" },
    { "value": 4, "label": "Çoğu zaman" },
    { "value": 5, "label": "Her zaman" }
  ],
  "scoring": {
    "method": "sum",
    "multiplier": 4,
    "range": { "min": 0, "max": 100 },
    "interpretation": [
      { "min": 0, "max": 28, "label": "Düşük iyi-oluş; taranması önerilir" },
      { "min": 29, "max": 49, "label": "Sınırda iyi-oluş" },
      { "min": 50, "max": 100, "label": "İyi oluş düzeyi normal" }
    ]
  },
  "source": "WHO / Psychiatric Research Unit, Frederiksborg (1998)",
  "note": "Türkçe madde metinleri klinik ekip tarafından doğrulanmalı."
}
